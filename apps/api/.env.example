# Copy to apps/api/.env and fill in real values. Never commit apps/api/.env.

DATABASE_URL="postgresql://aevo:aevo@localhost:5432/aevo?schema=public"
PORT=3001
NODE_ENV=development

# Required: the server refuses to boot without it.
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Optional. Defaults to `${JWT_SECRET}:reset`; set it explicitly in production.
RESET_TOKEN_SECRET=

# Frontend origin (CORS + where the OAuth callback redirects to)
CLIENT_URL=http://localhost:3000
# Public URL of this API. The OAuth redirect URI is built from it, so it must
# match the URI registered with the provider exactly.
API_URL=http://localhost:3001

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth - https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# SMTP (optional). Without it emails are only written to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AEVO <no-reply@aevo.com>"

# Google Gemini AI (optional - enables live LLM RAG Chatbot & Multimodal Vision Image Search, auto-falls back to Local AI Engine if omitted or quota depleted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
